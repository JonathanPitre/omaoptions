CONFIG_PATH = os.path.join(CONF_DIR, "config.json")
STATE_PATH = os.path.join(CONF_DIR, "state.json")
STATUS_PATH = os.path.join(CONF_DIR, "status.json")
DEVICES_PATH = os.path.join(CONF_DIR, "devices.json")
