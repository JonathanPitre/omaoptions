#!/usr/bin/env python3
"""omaoptions — Logi Options-style configuration for Logitech devices on Omarchy.

Backend for the `andreinita21.omaoptions` omarchy-shell plugin. Every
Logitech mouse or keyboard Solaar can talk to (Bolt, Unifying, Bluetooth,
USB) is discovered live by the engine (bin/omaoptions-daemon); this script
turns ~/.config/omarchy/omaoptions/config.json into Solaar state:

  * device settings written through Solaar and persisted in
    ~/.config/solaar/config.yaml — DPI, wheel mode, SmartShift, thumb wheel,
    which buttons/keys are diverted, keyboard fn-swap / OS layout / backlight
  * ~/.config/solaar/rules.yaml — what happens on gestures, diverted keys and
    thumb-wheel events (Execute / KeyPress / MouseScroll / MouseClick)
  * ~/.config/hypr/omaoptions.lua — per-device vertical scroll factor

Slots (what can be remapped) and settings (what can be tuned) are derived
from what each device reports, so the panel only shows what exists.

Subcommands:
  get        devices + config + action catalog as JSON (for the panel)
  apply      write settings + rules, restart the engine   [--json '<config>']
  status     connection / battery / service state as JSON
  discover   list devices, their remappable keys and settings
  native     run a built-in action for a device (toggle-smartshift, cycle-dpi, …)
  doctor     human-readable diagnostics dump
  defaults   print the built-in defaults
"""

import argparse
import contextlib
import copy
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

