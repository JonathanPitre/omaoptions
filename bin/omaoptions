ACTIONS_PATH = os.path.join(PLUGIN_DIR, "actions.json")
SOLAAR_DIR = os.path.join(HOME, ".config", "solaar")
RULES_PATH = os.path.join(SOLAAR_DIR, "rules.yaml")
HYPR_LUA = os.path.join(HOME, ".config", "hypr", "omaoptions.lua")
HYPR_MAIN = os.path.join(HOME, ".config", "hypr", "hyprland.lua")
SERVICE = "omaoptions.service"
CLI_PATH = os.path.realpath(__file__)

CONFIG_VERSION = 4

