#!/usr/bin/env python3
"""omaoptions-daemon — headless Solaar engine for the OmaOptions Omarchy plugin.

Runs Solaar's receiver listener (the same code the Solaar GUI uses) without
any window or tray icon, as a user service:

  * applies the persisted Solaar settings (~/.config/solaar/config.yaml) to a
    device when it connects — DPI, wheel mode, SmartShift, thumb-wheel and
    key diversion, keyboard fn-swap / layout / backlight
  * evaluates ~/.config/solaar/rules.yaml: mouse gestures on the diverted
    gesture button, diverted keys/buttons, thumb-wheel events → Execute /
    KeyPress / MouseScroll / MouseClick
  * writes battery / connection state to ~/.config/omarchy/omaoptions/status.json
    (from notifications plus a slow poll) and the devices' remappable keys to
    devices.json, so the bar never has to open the receiver itself

It talks to the Bolt receiver and to Bluetooth devices the way Solaar does,
which — unlike logiops 0.3.x — actually works on this hardware.
"""

from copy import deepcopy
from dataclasses import dataclass, field
import json
import logging
import os
import signal
import sys
import time
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".config", "omarchy", "omaoptions")
STATUS_PATH = os.path.join(STATE_DIR, "status.json")
DEVICES_PATH = os.path.join(STATE_DIR, "devices.json")
PENDING_PATH = os.path.join(STATE_DIR, "pending.json")
BATTERY_POLL_SEC = 300
RECOVERY_SETTINGS = ("fn-swap", "divert-keys")
RECOVERY_DELAY_MS = 1500
RECOVERY_MAX_DELAY_MS = 30000

logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s: %(message)s", stream=sys.stderr)
for noisy in ("logitech_receiver.base", "logitech_receiver.hidpp20", "logitech_receiver.device", "logitech_receiver.receiver",
              "logitech_receiver.settings", "logitech_receiver.notifications", "solaar.listener", "solaar.configuration"):
    logging.getLogger(noisy).setLevel(logging.ERROR)
log = logging.getLogger("omaoptions")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

# Solaar's KeyPress action maps keysyms through the GDK keymap, which only
# exists once GDK has opened the display — do that before importing Solaar.
if not Gtk.init_check()[0]:
    log.warning("no display: simulated key presses will not work until the session is up")

from solaar import configuration, listener  # noqa: E402
from logitech_receiver import settings_templates  # noqa: E402
from logitech_receiver.hidpp20 import Hidpp20, MappingFlag  # noqa: E402
from logitech_receiver.hidpp20_constants import SupportedFeature  # noqa: E402
from logitech_receiver.settings import SENSITIVITY_IGNORE  # noqa: E402

try:
    from solaar import dbus as solaar_dbus
except Exception:  # pragma: no cover - optional
    solaar_dbus = None

try:
    from logitech_receiver.hidpp20 import KeyFlag
except Exception:  # pragma: no cover
    KeyFlag = None

# path -> Device (devices only, never receivers)
_devices = {}
_keys_recorded = set()
_key_shapes = {}    # device key -> (key table length, reported keys) while discovery has holes
_scan_complete = {} # device key -> True once Solaar's feature scan ran to the end
_recoveries = {}
_hidpp20 = Hidpp20()
_last_online = {}   # serial/name -> time.time() when last seen online
_last_battery = {}  # serial/name -> (level, charging, full)


@dataclass
class DeviceRecovery:
    device: object
    source: int = 0
    delay: int = RECOVERY_DELAY_MS
    restored: set = field(default_factory=set)
    pending_misses: set = field(default_factory=set)
    saved: dict | None = None


class DeviceReadback:
    def __init__(self, device):
        self.device = device

    def __getattr__(self, name):
        return getattr(self.device, name)

    def feature_request(self, *args, **kwargs):
        # Solaar's key reporting reader converts FeatureCallError into default
        # flags. Confirmation must preserve a missing reply as a failure.
        try:
            reply = self.device.feature_request(*args, **kwargs)
        except Exception as ex:
            raise OSError(f"setting confirmation failed: {ex}") from ex
        if not reply:
            raise OSError("device did not answer setting confirmation")
        return reply


def _atomic_write(path, payload):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f, indent=2, sort_keys=True)
    os.replace(tmp, path)


def _link(device):
    if getattr(device, "receiver", None):
        return "receiver"
    if getattr(device, "bluetooth", False):
        return "bluetooth"
    return "usb"


def _battery_fields(device):
    info = getattr(device, "battery_info", None)
    if info is None:
        return None, None, None
    level = info.level
    try:
        level = int(level) if level is not None else None
    except (TypeError, ValueError):
        level = None
    st = str(info.status).lower() if info.status is not None else ""
    charging = ("recharg" in st) or ("almost_full" in st)
    full = st.endswith(".full")
    return level, charging, full


def _snapshot():
    devices = []
    for path, d in list(_devices.items()):
        try:
            key = str(getattr(d, "serial", "") or d.name)
            level, charging, full = _battery_fields(d)
            if d.online:
                _last_online[key] = time.time()
                if level is not None:
                    _last_battery[key] = (level, charging, full)
            elif level is None and key in _last_battery:
                level, charging, full = _last_battery[key]
            devices.append({
                "name": str(d.name or ""),
                "kind": str(d.kind or ""),
                "link": _link(d),
                "online": bool(d.online),
                "battery": level,
                "charging": bool(charging),
                "full": bool(full),
                "serial": str(getattr(d, "serial", "") or ""),
                "lastOnline": _last_online.get(key),
            })
        except Exception as ex:  # a device object mid-teardown
            log.debug("snapshot skipped %s: %s", path, ex)
    return devices


def write_status(force=False):
    devices = _snapshot()
    # keep the last known list until devices attach after a restart, but do
    # publish an explicit emptying (for example the last unpair) right away
    if not devices and not force and os.path.exists(STATUS_PATH):
        return
    _atomic_write(STATUS_PATH, {"at": time.time(), "devices": devices})


def record_keys(device):
    key = str(getattr(device, "serial", "") or device.name)
    if not device.online:
        return False
    keys = []
    try:
        ks = device.keys
        if not ks and device.protocol >= 2.0:
            features = device.features
            if (not features or (device.persister or {}).get("divert-keys") is not None
                    or SupportedFeature.REPROG_CONTROLS_V2 in features
                    or SupportedFeature.REPROG_CONTROLS_V4 in features):
                return False
        holes = 0
        for i in range(len(ks) if ks is not None else 0):
            k = ks[i]
            if k is None:
                # A slot the firmware never reports stays None forever, so wait
                # for the table shape to repeat across two attempts, then record
                # the keys that exist.
                holes += 1
                continue
            flags = k.flags
            if flags is None or KeyFlag is None:
                divertable = True
            else:
                try:
                    divertable = KeyFlag.DIVERTABLE in flags
                except TypeError:
                    divertable = bool(int(getattr(flags, "value", flags)) & 0x20)
            keys.append({"name": str(k.key), "cid": int(k.key), "divertable": bool(divertable)})
        if holes:
            shape = (len(ks), len(keys))
            if _key_shapes.get(key) != shape:
                _key_shapes[key] = shape
                return False
            _key_shapes.pop(key, None)
    except Exception as ex:
        log.warning("could not read keys of %s: %s", device.name, ex)
        return False
    try:
        settings = device.settings
        scanned = True
        # Solaar can latch feature discovery before keys are ready. Retry it
        # against the same list so missing settings are added without duplicates.
        if device.protocol >= 2.0:
            online = device.online
            present = getattr(device, "present", None)
            was_active = getattr(device, "_active", None)
            scanned = settings_templates.check_feature_settings(device, settings)
            # On an internal HID++ error Solaar guesses the device is gone and
            # flips online/present, and the listener may never notify again, so
            # that guess would end recovery. Undo it only when Solaar itself has
            # not seen a real transition: changed() assigns _active together
            # with online before any listener work, so an unchanged _active
            # means the flip came from the guess, not from a disconnect or an
            # unpair.
            if (online and present and not device.present and bool(device)
                    and was_active is not False and getattr(device, "_active", None) == was_active):
                device.online = True
                device.present = present
            if not scanned:
                return False
            _scan_complete[key] = True
        settings = sorted({str(st.name) for st in settings})
        saved = device.persister or {}
        required = {name for name in RECOVERY_SETTINGS if saved.get(name) is not None
                    and saved.get("_sensitive", {}).get(name) != SENSITIVITY_IGNORE
                    and (not scanned or name in settings)}
        if not required.issubset(settings) or not device.online:
            return False
    except Exception as ex:
        log.warning("could not read settings of %s: %s", device.name, ex)
        return False
    if not keys or key in _keys_recorded:
        return True
    try:
        with open(DEVICES_PATH) as f:
            existing = json.load(f).get("devices", [])
    except Exception:
        existing = []
    existing = [e for e in existing if e.get("name") != str(device.name)]
    existing.append({"name": str(device.name), "kind": str(device.kind or ""), "link": _link(device),
                     "serial": str(getattr(device, "serial", "") or ""), "online": True,
                     "keys": keys, "settings": settings})
    _atomic_write(DEVICES_PATH, {"at": time.time(), "devices": existing})
    _keys_recorded.add(key)
    log.info("%s: %d remappable keys recorded", device.name, sum(1 for k in keys if k["divertable"]))
    return True


def cancel_recovery(key):
    recovery = _recoveries.pop(key, None)
    if recovery is not None:
        if recovery.source:
            GLib.source_remove(recovery.source)
        device_key = str(getattr(recovery.device, "serial", "") or recovery.device.name)
        _keys_recorded.discard(device_key)
        _key_shapes.pop(device_key, None)
        _scan_complete.pop(device_key, None)


def confirm_setting(device, setting, value):
    probe = DeviceReadback(device)
    if setting.name == "fn-swap":
        fresh = type(setting).build(probe)
        if fresh is None:
            return False
        # A new non-persisting setting cannot fall back to the saved value
        # when a live read fails, or rewrite the applied snapshot.
        fresh.persist = False
        return fresh.read(cached=False) == value
    keys = _hidpp20.get_keys(probe)
    if not keys:
        return False
    for cid, desired in value.items():
        index = keys.index(int(cid))
        if index is None or (MappingFlag.DIVERTED in keys[index].mapping_flags) != bool(desired):
            return False
    return True


def recover_device(key, recovery):
    device = recovery.device
    if _recoveries.get(key) is not recovery:
        return False
    recovery.source = 0
    if not device.online or not bool(device):
        cancel_recovery(key)
        return False
    try:
        if recovery.saved is None:
            saved = device.persister
            if saved is None:
                raise RuntimeError("Solaar configuration is not ready")
            recovery.saved = deepcopy(dict(saved))
        if record_keys(device):
            saved = recovery.saved
            settings = {s.name: s for s in device.settings}
            complete = True
            for name in RECOVERY_SETTINGS:
                value = saved.get(name)
                if name in recovery.restored or value is None or saved.get("_sensitive", {}).get(name) == SENSITIVITY_IGNORE:
                    continue
                setting = settings.get(name)
                if setting is None:
                    if _scan_complete.get(str(getattr(device, "serial", "") or device.name)):
                        # The scan ran to the end and still found no setting, so
                        # the device does not carry it and the saved value has
                        # nothing to apply to.
                        continue
                    complete = False
                    continue
                # False is a successful write.
                written = setting.write(deepcopy(value), save=False)
                confirmed = confirm_setting(device, setting, value)
                if written is None or not confirmed:
                    complete = False
                else:
                    recovery.restored.add(name)
            if complete and apply_pending(device, recovery.pending_misses):
                log.info("%s: saved key settings restored", device.name)
                return False
    except Exception as ex:
        log.warning("%s: device recovery failed: %s", device.name, ex)
    if device.online and bool(device):
        recovery.source = GLib.timeout_add(recovery.delay, recover_device, key, recovery)
        recovery.delay = min(recovery.delay * 2, RECOVERY_MAX_DELAY_MS)
    else:
        cancel_recovery(key)
    return False


def apply_pending(device, settled=None):
    """Settings `omaoptions apply` could not write because the device was
    offline are queued in pending.json; write them now that it is online."""
    try:
        with open(PENDING_PATH) as f:
            pending = json.load(f)
    except Exception:
        return True
    mine = [j for j in pending if j.get("device", "").lower() == str(device.name).lower()]
    if not mine or not device.online:
        return not mine
    try:
        from solaar.cli import config as cli_config
    except Exception as ex:
        log.warning("cannot apply pending settings: %s", ex)
        return False
    done = []
    blocked = []
    for job in mine:
        try:
            setting = next((s for s in device.settings if s.name == job.get("setting")), None)
            if setting is None:
                blocked.append(job)
                continue
            vals = [str(v) for v in job.get("values", [])]

            class _Args:
                pass
            a = _Args()
            a.value_key = vals[0] if vals else None
            a.extra_subkey = vals[1] if len(vals) > 1 else None
            a.extra2 = vals[2] if len(vals) > 2 else None
            result, message, value = cli_config.set(device, setting, a, True)
            log.info("%s: %s", device.name, message or f"{job['setting']}={vals}")
            confirmed = True
            if setting.name in RECOVERY_SETTINGS:
                desired = {int(a.value_key): value} if setting.name == "divert-keys" else value
                confirmed = confirm_setting(device, setting, desired)
            if result is not None and confirmed:
                done.append(job)
        except Exception as ex:
            log.warning("%s: pending %s failed: %s", device.name, job.get("setting"), ex)
    missing = {j.get("setting") for j in blocked}
    # A setting can still appear while Solaar latches feature discovery, so an
    # absent setting gets one attempt before it stops holding the recovery open.
    # Either way the job stays queued; a later reconnect applies it then.
    hopeless = [j for j in blocked if j.get("setting") in (settled or ())]
    if settled is not None:
        settled.clear()
        settled.update(missing)
    if not done:
        return len(hopeless) == len(mine)
    try:
        with open(PENDING_PATH) as f:
            fresh = json.load(f)
    except Exception:
        # Never wipe a queue that was edited between our two reads; leave the
        # file as it is and let the next attempt try again.
        return False
    # The queue file is shared with the panel CLI, so re-read it right before
    # removing only what this pass applied; jobs queued meanwhile must survive,
    # and a same-device job queued mid-round is applied on the next attempt.
    _atomic_write(PENDING_PATH, [j for j in fresh if j not in done])
    try:
        configuration.save()
    except Exception:
        pass
    leftover = [j for j in fresh if j.get("device", "").lower() == str(device.name).lower()
                and j not in done and j not in hopeless]
    return not leftover


def status_changed(device, alert=None, reason=None, refresh=False):
    # Receiver callbacks run on listener threads. Own recovery state and writes
    # on the GLib loop so repeated notifications cannot schedule two writers.
    if device.kind is not None:
        GLib.idle_add(device_changed, device, bool(device), bool(device.online))


def device_changed(device, present, online):
    try:
        key = getattr(device, "path", None) or getattr(device, "serial", None)
        removed = False
        if key is None:
            # Solaar ghosts an unpaired device as a namedtuple with neither
            # serial nor path. The ghost keeps receiver and number, so match on
            # that identity; without a receiver fall back to the name. Drop
            # every entry the ghost maps to, recovery or not.
            recv = getattr(device, "receiver", None)
            number = getattr(device, "number", None)

            def matches(other):
                if recv is not None:
                    return getattr(other, "receiver", None) is recv and getattr(other, "number", None) == number
                return getattr(other, "name", None) == getattr(device, "name", None)

            for stale in [k for k, known in _devices.items() if matches(known)]:
                _devices.pop(stale, None)
                removed = True
            for stale in [k for k, recovery in _recoveries.items() if matches(recovery.device)]:
                cancel_recovery(stale)
                removed = True
            write_status(removed)
            return False
        recovery = _recoveries.get(key)
        if recovery and (recovery.device is not device or not online or not present):
            cancel_recovery(key)
        if not present:  # unpaired / gone
            removed = key in _devices
            _devices.pop(key, None)
        else:
            _devices[key] = device
            if online and key not in _recoveries:
                recovery = DeviceRecovery(device)
                _recoveries[key] = recovery
                recovery.source = GLib.timeout_add(RECOVERY_DELAY_MS, recover_device, key, recovery)
        write_status(removed and not online)
    except Exception as ex:
        log.warning("status_changed failed: %s", ex)
    return False


def setting_changed(device, setting_class, vals):
    pass


def error_cb(reason, path):
    log.error("Solaar error %s on %s", reason, path)


def poll_battery():
    for d in list(_devices.values()):
        try:
            if d.online:
                b = d.battery()
                if b is not None:
                    d.set_battery_info(b)
        except Exception as ex:
            log.debug("battery poll %s: %s", d, ex)
    write_status()
    return True


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    configuration.defer_saves = True
    listener.setup_scanner(status_changed, setting_changed, error_cb)
    if solaar_dbus is not None:
        try:
            solaar_dbus.watch_suspend_resume(listener.start_all, listener.stop_all)
        except Exception as ex:
            log.info("suspend/resume watch unavailable: %s", ex)
    loop = GLib.MainLoop()

    def shutdown(*_):
        log.info("stopping")
        try:
            listener.stop_all()
            configuration.save()
        finally:
            loop.quit()

    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, shutdown)

    listener.start_all()
    GLib.timeout_add_seconds(BATTERY_POLL_SEC, poll_battery)
    GLib.timeout_add_seconds(20, lambda: (poll_battery(), False)[1])  # one early refresh after start
    write_status()
    log.info("OmaOptions engine running (Solaar %s)", getattr(__import__("solaar"), "__version__", "?"))
    loop.run()


if __name__ == "__main__":
    main()
